{
  "atomCode": "checkstyle",
  "name": "Static analysis report",
  "version": "1.2.0",
  "description": "Reads checkstyle, PMD or SpotBugs XML, counts by severity and publishes it.",
  "execution": {
    "packagePath": "checkstyle.jar",
    "language": "java",
    "target": "$atom_java_path -cp checkstyle.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "pattern": {
      "label": "报告 glob（逗号分隔）",
      "type": "vuex-input",
      "default": "**/checkstyle-result.xml, **/pmd.xml, **/spotbugsXml.xml, **/cppcheck*.xml"
    },
    "label": {
      "label": "报告名称",
      "type": "vuex-input",
      "default": "Static analysis"
    },
    "outputDir": {
      "label": "HTML 输出目录",
      "type": "vuex-input",
      "default": "out/static-analysis"
    },
    "maxErrors": {
      "label": "允许的 error 数（超过则失败）",
      "type": "vuex-input-number",
      "default": "0"
    },
    "allowUnreadableReports": {
      "label": "报告解析失败也继续（默认 false：解析失败即失败）",
      "type": "boolean",
      "default": "false"
    }
  },
  "output": {
    "total": {
      "type": "string",
      "description": "问题总数"
    },
    "errors": {
      "type": "string",
      "description": "error 级"
    },
    "warnings": {
      "type": "string",
      "description": "warning 级"
    },
    "infos": {
      "type": "string",
      "description": "info 级"
    },
    "report": {
      "type": "report",
      "description": "构建页内嵌报告"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.4.0"
    }
  }
}
